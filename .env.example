# Server Configuration
PORT=3000
NODE_ENV=development

# Downloader Adapter Configuration
# Options: tikwm | rapidapi
DEFAULT_ADAPTER=tikwm

# RapidAPI Configuration (Optional, only needed if DEFAULT_ADAPTER=rapidapi)
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-downloader-download-tiktok-videos-without-watermark.p.rapidapi.com

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
REQUEST_TIMEOUT_MS=15000
